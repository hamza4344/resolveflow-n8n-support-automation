      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "review",
              "leftValue": "={{ $json.needs_review }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5f18d463-509e-5a63-81ce-f285fd631895",
      "name": "Review queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        -120
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => ({json: {...item.json, route: 'human_review'}}));"
      }
    },
    {
      "id": "97940816-ab9c-53a3-b748-ed2f35b9a0e8",
      "name": "Prepared outbox",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        120
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => ({json: {...item.json, route: item.json.status === 'rejected' ? 'rejected' : 'outbox'}}));"
      }
    },
    {
      "id": "2357eac3-e972-5d20-8a7a-613741103393",
      "name": "Intake response",
